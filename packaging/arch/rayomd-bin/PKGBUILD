# Maintainer: Milosz Kucharski <miloszkucharski at gmail dot com>
pkgname=rayomd-bin
_pkgname=rayomd
pkgver=5.2.1
pkgrel=1
pkgdesc='Tiny native Markdown-to-PDF converter (prebuilt static release binary)'
arch=('x86_64')
url='https://github.com/Butterski/rayomd'
license=('Apache-2.0' 'LGPL-2.1-or-later')
optdepends=('ttf-dejavu: TrueType font for non-Latin-1 text (Polish, Cyrillic, ...)'
            'noto-fonts: alternative TrueType font and script fallbacks')
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname")
options=('!strip' '!debug')
source=("$url/releases/download/v$pkgver/$_pkgname-$pkgver-linux-x64-static.tar.gz")
sha256sums=('b316a32208578f31b09ade12e50cd5dd1791a29470ca1f7e974e5d69b8d40703')

package() {
  cd "$_pkgname-$pkgver-linux-x64-static"
  install -Dm755 rayomd "$pkgdir/usr/bin/rayomd"
  install -Dm644 LICENSE NOTICE -t "$pkgdir/usr/share/licenses/$_pkgname/"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$_pkgname/"
}
