# SPDX-License-Identifier: Apache-2.0
# Editor settings for RayoMD's files (https://editorconfig.org).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[PKGBUILD]
indent_size = 2

[*.{bat,cmd,ps1}]
end_of_line = crlf

[third_party/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
